{
  "Backup": {
    "RutaNas": "\\\\192.168.0.3\\backup bd negosys",
    "ArchivoEstaciones": "estaciones.csv",
    "Estaciones": [],
    "Solo": "",
    "MaxConcurrencia": 4,
    "CarpetaLocalEstacion": "C:\\Backup",
    "VerificarBackup": true,
    "TimeoutConexionSegundos": 15,
    "TimeoutEstacionHoras": 8,
    "CrearCarpetaEstacion": false,
    "Retencion": {
      "Dias": 60,
      "ConservarSiempre": 2
    },
    "Reintentos": {
      "Intentos": 5,
      "EsperaSegundos": 30
    }
  },

  "Credenciales": {
    "AdminUsuario": "Administrador",
    "AdminClave": "",
    "SqlUsuario": "",
    "SqlClave": ""
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\LogsBackup\\Central\\BackupFE-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
